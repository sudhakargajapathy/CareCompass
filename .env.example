# API Keys (Required)
OPENAI_API_KEY=your_openai_api_key_here
APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Authentication Database (PostgreSQL)
AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/carecompass
AUTH_BOOTSTRAP_ADMIN=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_now

# Audit Logging
AUDIT_LOG_PATH=./logs/audit.log

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Encryption Key for Data at Rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here
# Optional key ring for rotation: key_id:key_value,key_id2:key_value2
ENCRYPTION_KEYRING=primary:your_primary_key,previous:your_previous_key

# Optional TLS for Streamlit
STREAMLIT_SERVER_SSL_CERT_FILE=/path/to/fullchain.pem
STREAMLIT_SERVER_SSL_KEY_FILE=/path/to/privkey.pem

# Application Configuration
APP_NAME=CareCompass
# WARNING: ENV=production requires a working AUTH_DATABASE_URL. Without one the
# login screen reports "Authentication database is not configured" and nobody
# can get in. Leave this as development for demo deployments (e.g. Hugging Face
# Spaces), where the app auto-authenticates as dev_admin.
ENV=development
DEBUG=false

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=healthcare_providers

# Search Configuration
DEFAULT_SEARCH_RADIUS=25
MAX_PROVIDERS_PER_SEARCH=20
EMBEDDING_MODEL=text-embedding-3-small
