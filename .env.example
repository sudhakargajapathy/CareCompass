# API Keys (Required)
OPENAI_API_KEY=your_openai_api_key_here
APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Authentication Database (PostgreSQL)
AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/carecompass
AUTH_BOOTSTRAP_ADMIN=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_now

# Audit Logging
AUDIT_LOG_PATH=./logs/audit.log

# Rate Limiting
# On a public demo (no auth database) every visitor shares one identity, so
# this window doubles as the GLOBAL demo budget. For a daily cap on a public
# deployment use e.g. RATE_LIMIT_MAX_REQUESTS=25, RATE_LIMIT_WINDOW_SECONDS=86400.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Encryption Key for Data at Rest (must be a Fernet key; passphrase
# derivation is no longer supported)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Optional TLS for Streamlit
STREAMLIT_SERVER_SSL_CERT_FILE=/path/to/fullchain.pem
STREAMLIT_SERVER_SSL_KEY_FILE=/path/to/privkey.pem

# Search Performance
# TAVILY_SEARCH_DEPTH: basic (fast, 1 credit) or advanced (deep, 2 credits).
# The UI's fast-demo toggle overrides this per session. Platform-targeted
# searches (discovery Q3 and the per-provider enrichment pass) always run
# advanced regardless.
TAVILY_SEARCH_DEPTH=basic

# Per-role model knobs (env flips for model experiments).
# GATHERER/CRITIC are Anthropic model IDs; JUDGE is an OpenAI model ID
# (the scorer uses the OpenAI client — cross-family judge/critic
# independence is deliberate). JUDGE_MODEL must be the FULL id
# "gpt-5.6-terra" — the bare "gpt-5.6" alias routes to Sol at 2x the price.
GATHERER_MODEL=claude-haiku-4-5
JUDGE_MODEL=gpt-5.6-terra
CRITIC_MODEL=claude-opus-4-8

# Enrichment budget: a RUNAWAY GUARD, not a rationing device. Every provider
# the cache didn't serve gets a live review pass, and providers past the cap
# are marked `over_budget` rather than dropped silently. (The tiered budget
# this once described — ENRICHMENT_POOL_SIZE, tier-1 second opinions — was
# deleted in Phase 2 and no code reads that knob any more.)
#
# It gates enrichment, the judge AND the critic, so it scales the bill close
# to linearly. 8 equals ENRICHMENT_MAX_WORKERS, which makes enrichment exactly
# one wave. Raise it if shortlists start arriving with fewer than 5 cards —
# the shortlist only draws on providers that completed all three stages, so
# this number is also the headroom for coverage failures.
MAX_PROVIDERS_TO_ENRICH=8

# How many providers enrichment researches CONCURRENTLY. Sets the number of
# waves — ceil(MAX_PROVIDERS_TO_ENRICH / this) — not the amount of work.
ENRICHMENT_MAX_WORKERS=8

# Enrichment cache: how long stored review/tenure/insurance evidence stays
# usable. 0 disables reuse entirely (every search runs cold) without
# discarding the stored data.
PROVIDER_CACHE_TTL_DAYS=7

# Multi-query discovery recall. Several phrasings surface more distinct
# providers than one; ring expansion to nearby cities fires ONLY when the home
# pool comes back thin. Set MIN_CANDIDATE_POOL equal to MAX_PROVIDERS_TO_ENRICH
# so the rule reads "ring out exactly when the home city cannot fill the
# research budget"; lowering it alone means "only rescue genuinely sparse
# towns". MULTI_QUERY_ENABLED=false restores the single-query path.
MULTI_QUERY_ENABLED=true
MIN_CANDIDATE_POOL=8
MAX_RING_CITIES=2

# Application Configuration
APP_NAME=CareCompass
ENV=development
DEBUG=false

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=healthcare_providers

# Search Configuration
DEFAULT_SEARCH_RADIUS=25
MAX_PROVIDERS_PER_SEARCH=20
EMBEDDING_MODEL=text-embedding-3-small
